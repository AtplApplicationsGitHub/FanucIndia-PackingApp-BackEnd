generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int            @id @default(autoincrement())
  name                     String
  email                    String         @unique
  password                 String
  role                     String         @default("SALES")
  salesZoneId              Int?
  salesZone                SalesZone?     @relation(fields: [salesZoneId], references: [id])
  currentSessionId         String?
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
  salesOrders              SalesOrder[]   @relation("CreatedOrders")
  assignedOrders           SalesOrder[]   @relation("AssignedOrders")
  issueAssignedOrders      SalesOrder[]   @relation("IssueAssignedOrders")
  packingAssignedOrders    SalesOrder[]   @relation("PackingAssignedOrders")
  dispatches               Dispatch[]
  vehicleEntries           VehicleEntry[]
  accessPickPack           Boolean        @default(false)
  accessLabelPrint         Boolean        @default(false)
  accessMaterialFgTransfer Boolean        @default(false)
  accessMaterialDispatch   Boolean        @default(false)
  accessVehicleEntry       Boolean        @default(false)
  accessLocationAccuracy   Boolean        @default(false)
  accessContentAccuracy    Boolean        @default(false)
  accessPutAway            Boolean        @default(false)
  accessErpBarcode         Boolean        @default(false)
  accessAttachment         Boolean        @default(false)
  accessManualFgLocation   Boolean        @default(false)

  sentSoChatMessages     SalesOrderChatMessage[] @relation("SoChatFrom")
  receivedSoChatMessages SalesOrderChatMessage[] @relation("SoChatTo")
  soChatNotifications    SoChatNotification[]
  customerLabelPrints    CustomerLabelPrint[]
  salesOrderAttachments  SalesOrderAttachment[]

  bomAuditsAsOperator BomAudit[] @relation("BomAuditOperator")
  bomAuditsCreated    BomAudit[] @relation("BomAuditCreatedBy")

  cycleCountAuditsAsOperator CycleCountAudit[]       @relation("CycleCountOperator")
  cycleCountAuditsCreated    CycleCountAudit[]       @relation("CycleCountCreatedBy")
  cycleCountStockUploads     CycleCountStockUpload[] @relation("CycleCountStockUploadedBy")
}

model Product {
  id             Int                 @id @default(autoincrement())
  name           String
  salesOrders    SalesOrder[]
  archivedOrders SalesOrderArchive[]
}

model Transporter {
  id          Int          @id @default(autoincrement())
  name        String
  salesOrders SalesOrder[]
  dispatches  Dispatch[]
}

model PlantCode {
  id          Int     @id @default(autoincrement())
  code        String
  description String?
}

model SalesZone {
  id             Int                 @id @default(autoincrement())
  name           String
  salesOrders    SalesOrder[]
  archivedOrders SalesOrderArchive[]
  users          User[]
}

model PackConfig {
  id          Int          @id @default(autoincrement())
  configName  String
  salesOrders SalesOrder[]
}

model Customer {
  id             Int                 @id @default(autoincrement())
  name           String
  address        String?
  contactNumber  String?
  salesOrders    SalesOrder[]
  archivedOrders SalesOrderArchive[]

  @@unique([name, address])
}

model Printer {
  id          Int          @id @default(autoincrement())
  name        String
  salesOrders SalesOrder[]
}

model SalesOrder {
  id                    Int                     @id @default(autoincrement())
  userId                Int
  productId             Int
  saleOrderNumber       String                  @db.VarChar(500)
  outboundDelivery      String                  @db.VarChar(500)
  transferOrder         String?                 @db.VarChar(500)
  deliveryDate          DateTime                @db.Date
  transporterId         Int
  plantCode             String?                 @db.VarChar(100)
  paymentClearance      Boolean
  salesZoneId           Int
  packConfigId          Int?
  assignedUserId        Int?
  customerId            Int?
  customerNameText      String?                 @db.VarChar(500)
  printerId             Int?
  specialRemarks        String?
  additionalRemarks     String?
  labelRemarks          String?
  fgLocation            Json?
  address               String?                 @db.VarChar(1000)
  status                String?
  priority              Int?
  skipStage             Boolean?                @default(false)
  issueAssignedUserId   Int?
  packingAssignedUserId Int?
  skipIssueStage        Boolean?                @default(false)
  skipPackingStage      Boolean?                @default(false)
  IA_Time               DateTime?               @db.Timestamptz(3)
  PA_Time               DateTime?               @db.Timestamptz(3)
  efficiencyRecords     Efficiency_PP[]
  isErpImported         Int                     @default(0)
  binCount              Int?                    @default(0)
  auditLogs             Json                    @default("[]") @map("audit_logs")
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  materialData          ERP_Material_Data[]
  materialFilesByNumber ERP_Material_File[]     @relation("SO_File_By_Number")
  customer              Customer?               @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packConfig            PackConfig?             @relation(fields: [packConfigId], references: [id])
  printer               Printer?                @relation(fields: [printerId], references: [id])
  product               Product                 @relation(fields: [productId], references: [id])
  salesZone             SalesZone               @relation(fields: [salesZoneId], references: [id])
  assignedUser          User?                   @relation("AssignedOrders", fields: [assignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issueAssignedUser     User?                   @relation("IssueAssignedOrders", fields: [issueAssignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packingAssignedUser   User?                   @relation("PackingAssignedOrders", fields: [packingAssignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transporter           Transporter             @relation(fields: [transporterId], references: [id])
  user                  User                    @relation("CreatedOrders", fields: [userId], references: [id])
  Dispatch_SO           Dispatch_SO[]
  UpdatedBy             String?
  UpdatedDate           DateTime?               @updatedAt @db.Timestamptz(3)
  FGUpdatedBy           String?                 @db.VarChar(255)
  FGUpdatedDateTime     DateTime?               @db.Timestamptz(3)
  statusStepper         SO_Status_Stepper[]
  chatMessages          SalesOrderChatMessage[]
  soChatNotifications   SoChatNotification[]
  attachments           SalesOrderAttachment[]

  @@unique([saleOrderNumber, outboundDelivery])
}

model SalesOrderAttachment {
  id               Int      @id @default(autoincrement())
  salesOrderId     Int
  saleOrderNumber  String   @db.VarChar(500)
  outboundDelivery String   @db.VarChar(500)
  fileName         String   @db.VarChar(500)
  sftpPath         String   @db.VarChar(1000)
  mimeType         String?  @db.VarChar(255)
  fileSizeBytes    Int
  uploadedBy       Int
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [uploadedBy], references: [id])

  @@index([salesOrderId])
}

model ERP_Material_Data {
  ID                   BigInt   @id(map: "PK_ERP_Material_Data") @default(autoincrement())
  saleOrderNumber      String?  @db.VarChar(500)
  transferOrder        String?  @db.VarChar(500)
  FG_OBD               String?  @db.VarChar(500)
  Machine_Model        String?
  CNC_Serial_No        String?  @db.VarChar(100)
  Material_Code        String
  Material_Description String
  Batch_No             String   @db.VarChar(100)
  SO_Donor_Batch       String   @db.VarChar(100)
  Cert_No              String   @db.VarChar(100)
  Bin_No               String   @db.VarChar(100)
  A_D_F                String   @db.VarChar(100)
  Required_Qty         Int
  Issue_stage          Int      @default(0)
  Packing_stage        Int      @default(0)
  Remarks              String?  @db.VarChar(500)
  Mapping_Barcode      String?  @db.VarChar(100)
  Group                String?  @db.VarChar(100)
  Accept_Bulk_Data     Boolean?
  Remarks_Required     Boolean?
  Classification       String?  @db.VarChar(100)

  UpdatedDate        DateTime?   @db.Timestamptz(3)
  UpdatedBy          String?     @db.VarChar(50)
  IssueUpdatedDate   DateTime?   @db.Timestamptz(3)
  IssueUpdatedBy     String?     @db.VarChar(50)
  PackingUpdatedDate DateTime?   @db.Timestamptz(3)
  PackingUpdatedBy   String?     @db.VarChar(50)
  salesOrderId       Int?
  salesOrder         SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ERPMaterialLog {
  id                Int      @id @default(autoincrement())
  dateTime          DateTime @map("date_time") @db.Timestamptz(3)
  fileName          String   @map("file_name") @db.VarChar(255)
  exceptionStatus   String?  @map("exception/status") @db.VarChar(255)
  soNo              String   @map("SO_NO") @db.VarChar(50)
  noOfFilesExecuted Int      @map("no_of_files_executed")

  @@map("ERP_Material_Log")
}

model ERP_Material_File {
  ID              Int      @id(map: "PK_ERP_Material_File") @default(autoincrement())
  saleOrderNumber String?  @db.VarChar(500)
  fileName        String   @db.VarChar(500)
  description     String?  @db.VarChar(2000)
  sftpPath        String   @db.VarChar(1000)
  sftpDir         String   @db.VarChar(1000)
  fileSizeBytes   BigInt
  mimeType        String?  @db.VarChar(255)
  checksumSha256  String?  @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  UpdatedBy          String?
  UpdatedDate        DateTime?   @updatedAt @db.Timestamptz(3)
  salesOrderId       Int?
  salesOrderByNumber SalesOrder? @relation("SO_File_By_Number", fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sftpPath])
  @@index([salesOrderId, fileName])
}

model Dispatch {
  id              Int      @id @default(autoincrement())
  transporterId   Int?
  transporterName String?
  vehicleNumber   String
  attachments     Json?
  createdBy       Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  transporter Transporter?  @relation(fields: [transporterId], references: [id])
  user        User          @relation(fields: [createdBy], references: [id])
  dispatchSOs Dispatch_SO[]

  UpdatedBy   String?
  UpdatedDate DateTime? @updatedAt @db.Timestamptz(3)

  vehicleEntryId Int?
  vehicleEntry   VehicleEntry? @relation(fields: [vehicleEntryId], references: [id])
}

model Dispatch_SO {
  id              Int        @id @default(autoincrement())
  dispatchId      Int
  saleOrderNumber String     @db.VarChar(500)
  LRnumber        String?    @db.VarChar(500)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  salesOrderId    Int
  dispatch        Dispatch   @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@unique([dispatchId, salesOrderId])
}

model SalesOrderArchive {
  id                    Int       @id @default(autoincrement())
  userId                Int
  productId             Int
  saleOrderNumber       String    @db.VarChar(500)
  outboundDelivery      String    @db.VarChar(500)
  transferOrder         String    @db.VarChar(500)
  deliveryDate          DateTime  @db.Date
  transporterId         Int
  plantCode             String?   @db.VarChar(100)
  paymentClearance      Boolean
  salesZoneId           Int
  packConfigId          Int
  assignedUserId        Int?
  customerId            Int?
  customerNameText      String?   @db.VarChar(500)
  printerId             Int?
  specialRemarks        String?
  additionalRemarks     String?
  labelRemarks          String?
  fgLocation            Json?
  address               String?
  status                String?
  priority              Int?
  skipStage             Boolean?
  issueAssignedUserId   Int?
  packingAssignedUserId Int?
  skipIssueStage        Boolean?
  skipPackingStage      Boolean?
  IA_Time               DateTime? @db.Timestamptz(3)
  PA_Time               DateTime? @db.Timestamptz(3)
  isErpImported         Int?
  binCount              Int?
  auditLogs             Json      @default("[]") @map("audit_logs")
  createdAt             DateTime  @db.Timestamptz(3)
  UpdatedBy             String?
  UpdatedDate           DateTime? @db.Timestamptz(3)
  FGUpdatedBy           String?   @db.VarChar(255)
  FGUpdatedDateTime     DateTime? @db.Timestamptz(3)
  archivedAt            DateTime  @default(now()) @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id])
  salesZone SalesZone @relation(fields: [salesZoneId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
}

model ERP_Material_DataArchive {
  ID                   BigInt   @id @default(autoincrement())
  saleOrderNumber      String?  @db.VarChar(500)
  salesOrderId         Int?
  transferOrder        String?  @db.VarChar(500)
  FG_OBD               String?  @db.VarChar(500)
  Machine_Model        String?
  CNC_Serial_No        String?  @db.VarChar(100)
  Material_Code        String
  Material_Description String
  Batch_No             String   @db.VarChar(100)
  SO_Donor_Batch       String   @db.VarChar(100)
  Cert_No              String   @db.VarChar(100)
  Bin_No               String   @db.VarChar(100)
  A_D_F                String   @db.VarChar(100)
  Required_Qty         Int
  Issue_stage          Int
  Packing_stage        Int
  Remarks              String?  @db.VarChar(500)
  Mapping_Barcode      String?  @db.VarChar(100)
  Group                String?  @db.VarChar(100)
  Accept_Bulk_Data     Boolean?
  Remarks_Required     Boolean?
  Classification       String?  @db.VarChar(100)

  UpdatedDate        DateTime? @db.Timestamptz(3)
  UpdatedBy          String?   @db.VarChar(50)
  IssueUpdatedDate   DateTime? @db.Timestamptz(3)
  IssueUpdatedBy     String?   @db.VarChar(50)
  PackingUpdatedDate DateTime? @db.Timestamptz(3)
  PackingUpdatedBy   String?   @db.VarChar(50)
  archivedAt         DateTime  @default(now()) @db.Timestamptz(3)
}

model ERP_Material_FileArchive {
  ID              Int       @id @default(autoincrement())
  saleOrderNumber String?   @db.VarChar(500)
  salesOrderId    Int?
  fileName        String    @db.VarChar(500)
  description     String?   @db.VarChar(2000)
  sftpPath        String    @db.VarChar(1000)
  sftpDir         String    @db.VarChar(1000)
  fileSizeBytes   BigInt
  mimeType        String?   @db.VarChar(255)
  checksumSha256  String?   @db.VarChar(64)
  createdAt       DateTime  @db.Timestamptz(3)
  UpdatedBy       String?
  UpdatedDate     DateTime? @db.Timestamptz(3)
  archivedAt      DateTime  @default(now()) @db.Timestamptz(3)
}

model DispatchArchive {
  id              Int       @id
  transporterId   Int?
  transporterName String?
  vehicleNumber   String
  attachments     Json?
  createdBy       Int
  createdAt       DateTime  @db.Timestamptz(3)
  UpdatedBy       String?
  UpdatedDate     DateTime? @db.Timestamptz(3)
  vehicleEntryId  Int?
  archivedAt      DateTime  @default(now()) @db.Timestamptz(3)
}

model Dispatch_SOArchive {
  id              Int      @id @default(autoincrement())
  dispatchId      Int
  saleOrderNumber String   @db.VarChar(500)
  LRnumber        String?  @db.VarChar(500)
  salesOrderId    Int
  createdAt       DateTime @db.Timestamptz(3)
  archivedAt      DateTime @default(now()) @db.Timestamptz(3)
}

model SO_Status_Stepper {
  id               Int        @id @default(autoincrement())
  salesOrderNumber String     @db.VarChar(500)
  salesOrderId     Int
  status           String
  createdDateTime  DateTime?  @db.Timestamptz(3)
  updatedBy        String?
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, status])
  @@map("SO_Status_Stepper")
}

model SO_Status_StepperArchive {
  id               Int       @id @default(autoincrement())
  salesOrderNumber String    @db.VarChar(500)
  salesOrderId     Int
  status           String
  createdDateTime  DateTime? @db.Timestamptz(3)
  updatedBy        String?
  archivedAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@map("SO_Status_StepperArchive")
}

model VehicleEntry {
  id              Int     @id @default(autoincrement())
  customerName    String?
  vehicleNumber   String
  transporterName String
  driverNumber    String?

  driverName String?
  inTime     String?
  outTime    String?

  attachments Json?

  createdBy Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user       User       @relation(fields: [createdBy], references: [id])
  dispatches Dispatch[]
}

model VehicleEntryArchive {
  id              Int     @id
  customerName    String?
  vehicleNumber   String
  transporterName String
  driverNumber    String?

  driverName String?
  inTime     String?
  outTime    String?

  attachments Json?

  createdBy Int
  createdAt DateTime @db.Timestamptz(3)
  updatedBy String?
  updatedAt DateTime @db.Timestamptz(3)

  archivedAt DateTime @default(now()) @db.Timestamptz(3)
}

model MaterialBarcode {
  id              Int     @id @default(autoincrement())
  erpCode         String  @unique
  mappingBarcode  String?
  group           String?
  acceptBulkData  Boolean @default(false)
  remarksRequired Boolean @default(false)
  classification  String?
}

model SalesOrderChatMessage {
  id Int @id @default(autoincrement())

  salesOrderId Int
  fromUserId   Int
  toUserId     Int

  message   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  fromUser      User                 @relation("SoChatFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User                 @relation("SoChatTo", fields: [toUserId], references: [id], onDelete: Cascade)
  notifications SoChatNotification[]

  @@index([salesOrderId, createdAt])
  @@index([toUserId, createdAt])
}

model SoChatNotification {
  id Int @id @default(autoincrement())

  userId       Int
  salesOrderId Int
  messageId    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  message    SalesOrderChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, createdAt])
}

model SalesOrderChatMessageArchive {
  id               Int      @id
  salesOrderNumber String   @db.VarChar(500)
  salesOrderId     Int
  fromUserId       Int
  toUserId         Int
  message          String   @db.VarChar(2000)
  createdAt        DateTime @db.Timestamptz(3)
  archivedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([salesOrderId, createdAt])
}

model SoChatNotificationArchive {
  id               Int      @id
  userId           Int
  salesOrderNumber String   @db.VarChar(500)
  salesOrderId     Int
  messageId        Int
  createdAt        DateTime @db.Timestamptz(3)
  archivedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model ERPMaterialLogArchive {
  id                Int      @id
  dateTime          DateTime @map("date_time") @db.Timestamptz(3)
  fileName          String   @map("file_name") @db.VarChar(255)
  exceptionStatus   String?  @map("exception/status") @db.VarChar(255)
  soNo              String   @map("SO_NO") @db.VarChar(50)
  noOfFilesExecuted Int      @map("no_of_files_executed")
  archivedAt        DateTime @default(now()) @db.Timestamptz(3)

  @@map("ERP_Material_LogArchive")
}

model CustomerLabelPrint {
  id        Int                       @id @default(autoincrement())
  createdAt DateTime                  @default(now()) @db.Timestamptz(3)
  userId    Int
  userName  String?
  cncText   String?                   @db.VarChar(255)
  boxNN     String?                   @db.VarChar(50)
  user      User                      @relation(fields: [userId], references: [id])
  entries   CustomerLabelPrintEntry[]
}

model CustomerLabelPrintEntry {
  id                   Int    @id @default(autoincrement())
  customerLabelPrintId Int
  saleOrderNumber      String @db.VarChar(500)
  salesOrderId         Int

  customerLabelPrint CustomerLabelPrint @relation(fields: [customerLabelPrintId], references: [id], onDelete: Cascade)
}

model ERP_Data_Cron_Logs {
  id              Int      @id @default(autoincrement())
  saleOrderNumber String
  status          String
  message         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
}

model SystemConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model ManualFgStorage {
  id               Int      @id @default(autoincrement())
  salesOrderNumber String   @db.VarChar(500)
  fgLocation       String   @db.VarChar(500)
  user             String   @db.VarChar(255)
  dateTime         DateTime @default(now()) @db.Timestamptz(3)

  @@index([salesOrderNumber])
}

model Order_Delete_Password {
  id        Int      @id @default(1)
  password  String
  updatedAt DateTime @updatedAt
}

model Efficiency_PP {
  id               Int      @id @default(autoincrement())
  salesOrderId     Int
  saleOrderNumber  String   @db.VarChar(500)
  outboundDelivery String   @db.VarChar(500)
  requiredDate     DateTime @db.Date
  userId           Int
  userName         String   @db.VarChar(255)
  leadTime         Float
  scanTime         Float
  bin              String   @db.VarChar(10)
  stage            String   @db.VarChar(20)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, stage])
}

model BomAudit {
  id              Int       @id @default(autoincrement())
  auditNo         String    @unique @db.VarChar(30)
  auditName       String    @db.VarChar(255)
  fileName        String    @db.VarChar(500)
  status          String    @default("ASSIGNED") @db.VarChar(30) // ASSIGNED | IN_PROGRESS | RECONCILIATION_PENDING | CLOSED (shared by all audit types)
  operatorId      Int
  operatorName    String    @db.VarChar(255)
  totalLocations  Int
  totalMaterials  Int
  createdById     Int
  createdByName   String    @db.VarChar(255)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  downloadedAt       DateTime? @db.Timestamptz(3)
  startedAt          DateTime? @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)
  submittedAt        DateTime? @db.Timestamptz(3)
  clientSubmissionId String?   @unique @db.VarChar(64)

  uploadBatchId String? @db.VarChar(36)

  reportPath        String?   @db.VarChar(500)
  reportGeneratedAt DateTime? @db.Timestamptz(3)
  reportAttempts    Int       @default(0)
  reportError       String?   @db.VarChar(1000)

  operator  User               @relation("BomAuditOperator", fields: [operatorId], references: [id])
  createdBy User               @relation("BomAuditCreatedBy", fields: [createdById], references: [id])
  locations BomAuditLocation[]
  materials BomAuditMaterial[]

  @@index([status])
  @@index([operatorId, status])
  @@index([uploadBatchId])
}

model BomAuditLocation {
  id                Int      @id @default(autoincrement())
  auditId           Int
  storageBin        String   @db.VarChar(100)
  sequenceNo        Int
  expectedMaterials Int
  verifiedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  audit     BomAudit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  materials BomAuditMaterial[]

  @@unique([auditId, storageBin])
}

model BomAuditMaterial {
  id              Int      @id @default(autoincrement())
  auditLocationId Int
  auditId         Int
  materialCode    String   @db.VarChar(100)
  expectedQty     Int
  actualQty       Int?
  lineStatus      String?   @db.VarChar(20)
  isUnexpected    Boolean   @default(false)
  lastScannedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  location BomAuditLocation @relation(fields: [auditLocationId], references: [id], onDelete: Cascade)
  audit    BomAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditLocationId, materialCode])
  @@index([auditId])
}

model CycleCountStockUpload {
  id              Int      @id @default(autoincrement())
  fileName        String   @db.VarChar(500)
  totalRows       Int
  validRows       Int
  excludedRows    Int
  totalLocations  Int
  totalPackages   Int
  hasCertNoColumn Boolean  @default(false)
  hasCncColumn    Boolean  @default(false)
  hasClassColumn  Boolean  @default(false)
  uploadedById    Int
  uploadedByName  String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  uploadedBy User                 @relation("CycleCountStockUploadedBy", fields: [uploadedById], references: [id])
  rows       CycleCountStockRow[]
  audits     CycleCountAudit[]

  @@index([createdAt])
}

model CycleCountStockRow {
  id              Int      @id @default(autoincrement())
  uploadId        Int
  rowNo           Int
  storageBin      String   @db.VarChar(100)
  materialCode    String   @db.VarChar(100)
  qty             Decimal? @db.Decimal(15, 3)
  certNo          String?  @db.VarChar(100)
  batch           String?  @db.VarChar(100)
  plant           String?  @db.VarChar(50)
  storageLocation String?  @db.VarChar(50)
  isCnc           Boolean?
  materialClass   String?  @db.VarChar(10)
  excludeReason   String?  @db.VarChar(40)

  upload CycleCountStockUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId, storageBin])
  @@index([uploadId, excludeReason])
}

/// One Cycle Count audit = the locations of ONE operator (a released plan creates one audit per operator).
model CycleCountAudit {
  id              Int       @id @default(autoincrement())
  auditNo         String    @unique @db.VarChar(30)
  auditName       String    @db.VarChar(255)
  status          String    @default("ASSIGNED") @db.VarChar(30) // ASSIGNED | IN_PROGRESS | RECONCILIATION_PENDING | CLOSED (shared by all audit types)
  operatorId      Int
  operatorName    String    @db.VarChar(255)
  stockUploadId   Int
  stockFileName   String    @db.VarChar(500)
  movementFrom    DateTime  @db.Date
  movementTo      DateTime  @db.Date
  includeArchived Boolean   @default(true)
  selectionMethod String    @db.VarChar(20)
  cncFilter       String    @db.VarChar(20)
  materialClasses String?   @db.VarChar(20)
  totalLocations  Int
  totalLines      Int
  uploadBatchId   String    @db.VarChar(36)
  createdById     Int
  createdByName   String    @db.VarChar(255)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  operator    User                  @relation("CycleCountOperator", fields: [operatorId], references: [id])
  createdBy   User                  @relation("CycleCountCreatedBy", fields: [createdById], references: [id])
  stockUpload CycleCountStockUpload @relation(fields: [stockUploadId], references: [id])
  locations   CycleCountLocation[]
  materials   CycleCountMaterial[]

  @@index([status])
  @@index([operatorId, status])
  @@index([uploadBatchId])
}

model CycleCountLocation {
  id            Int      @id @default(autoincrement())
  auditId       Int
  storageBin    String   @db.VarChar(100)
  sequenceNo    Int
  movementLines Int      @default(0)
  movementLevel String   @db.VarChar(10)
  expectedLines Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  audit     CycleCountAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  materials CycleCountMaterial[]

  @@unique([auditId, storageBin])
}

model CycleCountMaterial {
  id              Int      @id @default(autoincrement())
  auditId         Int
  auditLocationId Int
  materialCode    String   @db.VarChar(100)
  certNo          String?  @db.VarChar(100)
  batch           String?  @db.VarChar(100)
  expectedQty     Decimal  @db.Decimal(15, 3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  location CycleCountLocation @relation(fields: [auditLocationId], references: [id], onDelete: Cascade)
  audit    CycleCountAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([auditLocationId])
}

model AuditNoSequence {
  prefix     String   @db.VarChar(10)
  period     String   @db.VarChar(7)
  lastNumber Int
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([prefix, period])
}
